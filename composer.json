{
    "name": "crustum/notification-ui",
    "description": "Notification UI plugin for CakePHP applications",
    "type": "cakephp-plugin",
    "authors": [
        {
            "name": "Evgeny Tomenko",
            "homepage": "https://github.com/skie"
        }
    ],
   "license": "MIT",
    "require": {
        "php": ">=8.5",
        "crustum/notification": "2.x-dev",
        "markstory/asset_compress": "6.x-dev"
    },
    "require-dev": {
        "boundwize/structarmed": "^0.15",
        "cakedc/cakephp-phpstan": "5.next-cake6-dev",
        "cakephp/bake": "4.x-dev",
        "cakephp/cakephp": "6.x-dev",
        "cakephp/cakephp-codesniffer": "6.x-dev",
        "crustum/broadcasting": "2.x-dev",
        "crustum/debug-bar": "2.x-dev",
        "crustum/notification-broadcasting": "2.x-dev",
        "crustum/plugin-manifest": "2.x-dev",
        "phpstan/phpstan": "^2.3",
        "phpunit/phpunit": "^13.0",
        "rector/rector": "^2.7"
    },
    "suggest": {
        "crustum/notification-broadcasting": "Broadcasting notification channel",
        "crustum/mercure-broadcasting": "Mercure broadcaster driver"
    },
    "autoload": {
        "psr-4": {
            "Crustum\\NotificationUI\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Crustum\\NotificationUI\\Test\\": "tests/",
            "TestApp\\": "tests/TestApp/"
        }
    },
    "scripts": {
        "check": [
            "@cs-check",
            "@rector-check",
            "@test",
            "@analyse"
        ],
        "fix": [
            "@cs-fix",
            "@rector-fix",
            "@cs-fix",
            "@analyse"
        ],
        "analyse": [
            "@stan"
        ],
        "cs-check": "phpcs -p --standard=phpcs.xml src/ tests/",
        "cs-fix": "phpcbf --standard=phpcs.xml src/ tests/",
        "test": "phpunit",
        "test:unit": "phpunit --testsuite=Unit",
        "test:integration": "phpunit --testsuite=Integration",
        "test:coverage": "phpunit --coverage-html coverage",
        "stan": "vendor/bin/phpstan analyse src/ tests/",
        "rector-check": "vendor/bin/rector process --dry-run",
        "rector-fix": "vendor/bin/rector process",
        "stan-tests": "vendor/bin/phpstan analyze -c tests/phpstan.neon",
        "stan-baseline": "vendor/bin/phpstan --generate-baseline",
        "structarmed": "vendor/bin/structarmed analyze src"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        },
        "platform-check": false
    },
    "repositories": [
        {
            "type": "vcs",
            "url": "git@github.com:skie/cakephp-queue.git"
        }
    ]
}
